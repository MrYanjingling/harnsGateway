# 使用内置 mock 数据,无需启动 Go 后端。
# true 时 Vite 不会注册任何 proxy。
VITE_USE_MOCK=true

# 网关服务(cmd/gateway)地址,默认端口 32200
VITE_GATEWAY_TARGET=http://127.0.0.1:32200

# 数据服务(cmd/data)地址,默认端口 32201
VITE_DATA_TARGET=http://127.0.0.1:32201

# 生产环境可分别指定两套服务的基址,默认均为 /api/v1。
# VITE_GATEWAY_BASE=https://gateway.example.com/api/v1
# VITE_DATA_BASE=https://data.example.com/api/v1
